if (operandOpen) {
    curOpd = &accessOperand();
    if (curOpd->opdtype == SP_OPD_NULL) {
      // use all as default operand if not specified
      curOpd->opdtype = SP_OPD_LOGICAL;
     curOpd->codeID = SP_LOGIC_ALL;
    } 
    if (curOpd->opdtype != SP_OPD_LOGICAL) {
      // block operand cannot start group  
      output->setError(ERR_WRONG_OPERAND , posStart);
      throw(std::runtime_error("fatal"));
    }
  } else {
    curOpd = &setOperand();
    // use all as default operand if not specified
    curOpd->opdtype = SP_OPD_LOGICAL;
    curOpd->codeID = SP_LOGIC_ALL;
  };

// ****************************************************************************
// convert date in string to TFNum according to configuration
// aString - string holding number
// aNum    - converted float, UTC in second resolution,base date is October 15, 1582
// return nPos or index in string
// ****************************************************************************
std::size_t textDateToTFNum(const std::string &aString, TFNum &aNum) {
  int y =  0, m = 0, d = 0, n = 0, count;
  std::string format = config.dateFormat + "%n";
  try {
    count = sscanf((char*)aString.c_str(), format.c_str(), &y,&m,&d,&n); 
    if (count != dateFormatCount)
      return(nPos);
    Poco::DateTime dateTime = Poco::DateTime(y,m,d,0,0,0);
    Poco::Timestamp::UtcTimeVal timeUTC = dateTime.utcTime();
    aNum = (uint64_t)timeUTC / 1000000;  
  } catch (std::exception &aExp) {
    return(nPos);
  }  
  return(n - 1);
};

// ****************************************************************************
// convert date to string according to formatting in config
// aNum    - converted float, UTC in second resolution
// return  - formatted string
// ****************************************************************************
Poco::DateTime dateTFNumToDT(TFNum &aNum) {
  Poco::Timestamp::UtcTimeVal curTime = (uint64_t)aNum * 1000000;
  Poco::DateTime dateTime = Poco::DateTime(curTime, 0);
  
  return(dateTime);
}

// ****************************************************************************
// convert time in string to TFNum according to configuration
// aString - string holding number
// aNum    - converted float, holding overall seconds since midnight
// return true if successfull
// ****************************************************************************
std::size_t textTimeToTFNum(const std::string &aString, TFNum &aNum) {
  int h =  0, m = 0, s = 0, n = 0, count;
  std::string format = config.timeFormat + "%n";
  try {
    count = sscanf((char*)aString.c_str(), format.c_str(), &h,&m,&s,&n); 
    if (count != dateFormatCount)
      return(nPos);

    aNum = (uint64_t)(h * 60 * 60 + m * 60  + s); 
  } catch (std::exception &aExp) {
    return(nPos);
  }  
  return(n - 1);
};


// ****************************************************************************
// convert time to string according to formatting in config
// aNum    - converted float, holding overall seconds since midnight
// return  - formatted string
// ****************************************************************************
Poco::DateTime  timeTFNumToDT(TFNum &aNum) {
  int h = aNum / 3600;
  int m = (aNum - (h * 3600)) / 60;
  int s = (aNum - (h * 3600) - (m*60));
  Poco::DateTime dateTime = Poco::DateTime(1970, 1, 1, h, m, s);
  
  return(dateTime);
}

// ****************************************************************************
// convert date and time in string to TFNum according to configuration
// aString - string holding number
// aNum    - converted float, UTC in second resolution,base date is October 15, 1582
// return true if successfull
// ****************************************************************************
std::size_t textDateTimeToTFNum(const std::string &aString, TFNum &aNum) {
  int y =  0, m = 0, d = 0, h =  0, mi = 0, s = 0, n = 0, count;
  std::string format = config.dateTimeFormat + "%n";
  try {
    count = sscanf((char*)aString.c_str(), format.c_str(), &y,&m,&d,&h,&mi,&s,&n); 
    if (count != dateTimeFormatCount)
      return(nPos);
    Poco::DateTime dateTime = Poco::DateTime(y,m,d,h,mi,s);
    Poco::Timestamp::UtcTimeVal timeUTC = dateTime.utcTime();
    aNum = (uint64_t)timeUTC / 1000000;  
  } catch (std::exception &aExp) {
    return(nPos);
  }  
  return(n - 1);
};


// ****************************************************************************
// convert datetime to string according to formatting in config
// aNum    - converted float, UTC in second resolution,base date is October 15, 1582
// return  - formatted string
// ****************************************************************************
Poco::DateTime dateTimeTFNumToDT(TFNum &aNum) {
  Poco::Timestamp::UtcTimeVal curTime = (uint64_t)aNum * 1000000;
  Poco::DateTime dateTime = Poco::DateTime(curTime, 0);
  
  return(dateTime);
}

