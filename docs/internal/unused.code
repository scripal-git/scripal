template<typename SType> class TScripal {
  public:
  TScripal() {};
  
  TScripal(const SType &aSource) {};
  
  TScripal(const SType, int aMax);
    
  bool matchd(const SType &aText) {
    return(match(objID, (const char*)aText.c_str(), (int)aText.size() * sizeMul));
  };

  bool matchFile(const SType &aText, int aFileEncoding);

  bool replace(const SType &aText, const SType &aReplace); 
  
  bool replaceFile(const SType &aFileIn, const SType &aFileOut, const SType &aReplace, int aFileEncoding); 

  bool split(const SType &aText);   

  bool splitFile(const SType &aFileIn, const SType &aFileOut, int aFileEncoding);

  int getResultSize();

  SType getResult(int aIndex);

  int objID;              // object ID of underlying TFScripal object
  int sizeMul = 1;        // size mulitplicator for byte size , UTF16 = 2, UTF32 = 4   

};
template<> TScripal<std::string>::TScripal(const std::string &aSource) {
  if (encoding != ENC_DEFAULT)
    encoding = ENC_UTF8;
  sizeMul = 1;  
  objID = newCodeObj((char*)aSource.c_str(), aSource.size() * sizeMul);  
};

template<> TScripal<std::u16string>::TScripal(const std::u16string &aSource) {
  if (encoding != ENC_DEFAULT) {
    if (isBigEndian())
      encoding = ENC_UTF16B;
    else  
      encoding = ENC_UTF16L;
  }
  sizeMul = 2;  
  objID = newCodeObj((char*)aSource.c_str(), aSource.size() * sizeMul);  
};

template<> TScripal<std::u32string>::TScripal(const std::u32string &aSource) {
  if (encoding != ENC_DEFAULT) {
    if (isBigEndian())
      encoding = ENC_UTF32B;
    else  
      encoding = ENC_UTF32L;
  }
  sizeMul = 4;  
  objID = newCodeObj((char*)aSource.c_str(), aSource.size() * sizeMul);  
};


template<typename SType> int TScripal<SType>::getResultSize() {
  return(getResultSize(objID));
};

