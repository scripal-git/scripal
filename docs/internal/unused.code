old fiel search in main

void runFileSearch() {
  std::string error = "";
  error = runFileSearch(dirPath, source, dirExtension, dirRecursive);

  std::string path = dirPath;
  std::string outStr = "";

  auto matchFcn = [&](auto file) { 
    TFScripal*  obj = nullptr;
    if (!file.is_directory()) {
      std::string fileName = file.path().string();
      if (( fileName.find("." + dirExtension) !=  nPos) || (dirExtension == "*")) {
        std::cout << fileName << "\n";
        //  match
        if (obj != nullptr)
          delete obj;

        obj = new TFScripal(source);
 
        // error handling
        if (obj->error != "") { 
          std::cout << "Error: " << obj->error << "'\n"; 
          exitStatus = 1; 
          if (obj != nullptr)
            delete obj;
          return;
        }  

       if (config.showCode) 
         log("----- compilation -----\n" + printCode(obj->code));

        // add  result to outStr
        if (obj->matchFile(fileName, ENC_UTF8)) {
          if (resultJson)
            outStr += resultToJson(*obj, *obj, ENC_UTF8, fileName);
          else if (resultCsv)  
            outStr += resultToCSV(*obj, *obj, ENC_UTF8, fileName);
          else   
            outStr += resultToHRF(*obj, *obj, ENC_UTF8, fileName);
        }
      }
    };
    if (obj != nullptr)
      delete obj;
    return;
  };

  try {
    if (dirRecursive) {
      for (const auto & file : std::filesystem::recursive_directory_iterator(path)) {
        matchFcn(file);
        if (exitStatus > 0)
          return;
      }    
    } else {
      for (const auto & file : std::filesystem::directory_iterator(path)) {
        matchFcn(file);
        if (exitStatus > 0)
          return;
      }  
    }
  } catch (const std::exception &aExc) {
    std::cout << "Error: cannot access directory '" + dirPath + "' or empty" << "'\n"; 
    exitStatus = 1;
    return;    
  }  
  
  if (outStr != "")
    std::cout << outStr << "\n"; 
  
  return;
};


