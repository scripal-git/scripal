std::string pdfWhite = "\x9\xa\xc\xd\x20"; 

// ****************************************************************************
// test for keyword in PDF with whitespace as terminator
// aLine - extracted line
// aBlock - keyword to look for
// return - start of keyword or nPos
// ***************************************************************************
std::size_t testBlockPDF(const std::string &aLine, const std::string &aBlock) {
  std::size_t pos;
  pos = aLine.find(aBlock);
  if (pos == nPos)
    return(pos);

  if (pos + aBlock.size() >= aLine.size())
    return(pos);

  if (aLine.find_first_of(pdfWhite, pos) == pos + aBlock.size())
    return(pos);

  return(nPos);
}  

// ****************************************************************************
// read hexadecimal value in PDF format <>
// aLine - extracted line
// aStartPos - opening '<'
// aValue - value read
// return - end of value or nPos
// ***************************************************************************
std::size_t readHexPDF(const std::string &aLine, std::size_t aStartPos, char32_t &aValue ) {
  std::size_t pos = aLine.find('>', aStartPos);
  if (pos == nPos)
    return(nPos);
  aValue = std::stoul(aLine.substr(aStartPos + 1 , pos - aStartPos -1), nullptr, 16);   
  return(pos); 
}  

 
 
 
 // ****************************************************************************
// decode PDF files
// aData  - file with decoded streams  
// return - file content in UTF-8
// ****************************************************************************
std::string processPDF(const std::string &aData) {
  std::string line, result;
  std::istringstream stream(aData);
  std::vector<std::vector<char32_t>> chars;
  std::array<char32_t, 0xff> maps;
  char32_t map, curChar;
  std::size_t pos;
  bool textBlock = false, mapDef = false;
  
  while (!stream.eof()) {
    getline(stream, line);

    if ((pos = testBlockPDF(line, "BT")) != nPos) {
      // begin textblock
      textBlock = true;
    } else if ((pos = testBlockPDF(line, "ET")) != nPos) {
      // begin textblock
      textBlock = false;
    } else if ((pos = testBlockPDF(line, "beginbfchar")) != nPos) {
      // begin char mapping
      mapDef = true;
      std::fill_n(maps.begin(), 0xff, 0);
    } else if ((pos = testBlockPDF(line, "endbfchar")) != nPos) {
      // end char mapping
      if ((chars.size() > 0) && (maps.size() > 0)) {
        for (std::size_t index = 0; index < chars.size(); ++index) {
          if (chars[index][0] == 0x0)
            // special char
            result += toString(chars[index][1]);
          else 
            // char mapping
            result += toString(maps[chars[index][0]]);
        }
        
      }
      mapDef = false;
    } else {
      if (textBlock) {
        if (((testBlockPDF(line, "TD")) != nPos) || ((testBlockPDF(line, "Td")) != nPos)) {
          // new line
          chars.push_back({0, '\n'});
        }

        if ((pos = testBlockPDF(line,"Tj") != nPos)) { 
          // Tj string
          std::cout << line << "\n";
          pos = line.rfind("(");
          if (pos != nPos) { 
            // true string
            std::size_t endPos = line.find(")", pos);
            if (endPos != nPos) {
              // direct chars or maps? 
              result += line.substr(pos + 1, endPos - pos - 1);
              
            }
            continue;  
          }     

          pos = line.rfind("<");
          if (pos != nPos) { 
            // array
            ++pos;
            while (pos < line.size()) {
              if (line[pos] == '>')
                break;
              map = std::stoul(line.substr(pos , 2), nullptr, 16);
              chars.push_back({map, 0});
              pos += 2;
            }; 
            continue;  
          }     
        } else if ((pos = testBlockPDF(line,"TJ") != nPos)) {
          // TJ array Char Array
          pos = line.rfind("[<");
          if (pos == nPos)
            continue;
          pos +=2;  
          while (pos < line.size()) {
            if (line[pos] == ']')
              break; 
            map = std::stoul(line.substr(pos , 2), nullptr, 16);
            chars.push_back({map, 0});
            pos += 2;
            if (line[pos] == '>') {
              pos = line.find('<', pos);
              if (pos == nPos)
                break;
              ++pos;
            }   
          }  
        }
      } else if (mapDef) {
        // character definition
        if (line[0] == '<') {
          pos = readHexPDF(line,0, map);
          if (pos == nPos)
            continue;
            
          pos = line.find('<', 1);
          pos = readHexPDF(line,pos, curChar);
          if (pos != nPos) {
            if (map <= 255)
              maps[map] = curChar;
          } 
          
        } 
      }
    } 

  }
  
  return(result);
}

// ****************************************************************************
// decode PDF files
// aFile  - path to file 
// return - file content in UTF-8
// ****************************************************************************
std::string decodeFilePDF(const std::string &aFile) {
  std::string buffer;
  std::string data, result;
  readFromFile(aFile, buffer);
  std::size_t streamStart = 0;
  std::size_t streamEnd   = 0;
  std::size_t streamPos;

  while (streamStart != nPos) { 
    streamStart = buffer.find("stream", streamStart);
    streamEnd = buffer.find("endstream", streamStart);
    if (streamStart == nPos) 
      break;
    streamPos = streamEnd + 9;
    
    bool streamZipped = false;
    if (buffer.rfind("FlateDecode", streamStart) > streamStart - 30) 
      streamZipped = true;
    
    if ((!streamZipped) || (streamEnd <= streamStart)) { 
      streamStart = streamPos;
      continue;
    };

  	streamStart += 6;

    if (buffer[streamStart]==0x0d && buffer[streamStart+1]==0x0a) 
      streamStart += 2;
    else if (buffer[streamStart]==0x0a) 
      streamStart++;

    if (buffer[streamEnd-2]==0x0d && buffer[streamEnd-1]==0x0a) 
      streamEnd -= 2;
    else if (buffer[streamEnd-1]==0x0a) 
      streamEnd--;

    std::istringstream input(buffer.substr(streamStart, streamEnd - streamStart + 1));
    Poco::InflatingStreamBuf stream(input, Poco::InflatingStreamBuf::STREAM_ZLIB);
    try {
      while ( stream.snextc() != EOF ) {
        char ch = stream.sgetc();
        data.push_back(ch);
      };
    } catch (std::exception &aExc) {
      // image or alien encoding
    }

    streamStart = streamPos;
    if (streamStart >= buffer.size())
      break;
 }; 

 //std::cout << data << "\n";
 if (data.size() != 0) {
   result = processPDF(data);
 }
  return(result); 
};  

