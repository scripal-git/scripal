// ****************************************************************************
// search for files where source matches
// aPath         - path to search in
// aSource       - srcipal source 
// aDirExtension - file types to search for in directories (default: "*")
// aRecursive    - if true, search all subdirectories
// return - error string or empty string
// ****************************************************************************
std::string fileSearchSource(const std::string &aPath, const std::string &aSource, const std::string &aDirExtension, bool aRecursive) {
  TFScripal obj(aSource);
  
  if (obj.error != "")
    return(obj.error);
  
  TFFileIterate files(aPath, aDirExtension, aRecursive);
  if (files.error)
    return("path " + aPath + " not found or no permission");
  
  results.init(MATCH_SOURCE);
   
  while (files.error == 0) {
    files.iterate();
    if (files.error) 
      return("");

    std::string fileName = files.entry->path().string();
    if (obj.matchFile(fileName, ENC_UTF8)) {

      results.matchType = obj.results.matchType;
      results.push_back(obj.results);
    }
  };
  
  return("");
};

// ****************************************************************************
// search for files with nearest match
// aPath         - path to search in
// aSource       - source to compare with
// aMax          - maximum distance tomatch
// aDirExtension - file types to search for in directories (default: "*")
// aRecursive    - if true, serach all subdirectories
// return - error string or empty string
// ****************************************************************************
std::string fileSearchNearest(const std::string &aPath, const std::string &aSource, int aMax, const std::string &aDirExtension, bool aRecursive) {
  TFScripal obj(aSource, aMax);
  
  if (obj.error != "")
    return(obj.error);
  
  TFFileIterate files(aPath, aDirExtension, aRecursive);
  if (files.error)
    return("path " + aPath + " not found or no permission");
  
  results.init(MATCH_NEAREST);
   
  while (files.error == 0) {
    files.iterate();
    if (files.error) 
      return("");

    std::string fileName = files.entry->path().string();
   
    if (obj.matchFile(fileName, ENC_UTF8)) {
      results.matchType = obj.results.matchType;
      results.push_back(obj.results);
    }
  };
  
  return("");
};

// ****************************************************************************
// search for file(s) most similar to given file
// aPath         - path to search in
// aSrcFile      - source file 
// aMin          - minimum match rating to see file as a match
// aDirExtension - file types to search for in directories (default: "*")
// aRecursive    - if true, search all subdirectories
// aOutput       - output string, format depends on config.resultFormat 
// return - error string or empty string
// ****************************************************************************
std::string fileSearchhBlock(const std::string &aPath, const std::string &aSource, double aMin, const std::string &aDirExtension, bool aRecursive, std::string &aOutput) {
  TFScripal obj(aSource, aMin);
  
  if (obj.error != "")
    return(obj.error);
  
  TFFileIterate files(aPath, aDirExtension, aRecursive);
  if (files.error)
    return("path " + aPath + " not found or no permission");
  
  results.init(MATCH_BLOCK);
   
  while (files.error == 0) {
    files.iterate();
    if (files.error) 
      return("");

    std::string fileName = files.entry->path().string();
   
    if (obj.matchFile(fileName, ENC_UTF8)) {
      results.matchType = obj.results.matchType;
      results.push_back(obj.results);
    }
  };
  
  return("");
}

// ****************************************************************************
// search for files where source matches
// aPath         - path to search in
// aSource       - srcipal source 
// aDirExtension - file types to search for in directories (default: "*")
// aRecursive    - if true, serach all subdirectories
// aOutput       - output string, format depends on config.resultFormat 
// return - error string or empty string
// ****************************************************************************
std::string fileSearch(const std::string &aPath, const std::string &aSource, const std::string &aDirExtension, bool aRecursive, std::string &aOutput) {
  std::string path = aPath;
  std::string dirExtension;
  std::string error = "";
  TFScripal obj(aSource);

  auto matchFcn = [&](auto file) { 
    if (!file.is_directory()) {
      std::string fileName = file.path().string();
      if (( fileName.find("." + dirExtension) !=  nPos) || (dirExtension == "*")) {
        std::cout << fileName << "\n";

        // add  result to outStr
        if (obj.matchFile(fileName, ENC_UTF8)) {
          if (config.resultFormat == OPT_JSON)
            aOutput += resultToJson(obj, obj, ENC_UTF8, fileName);
          else if (config.resultFormat == OPT_CSV)  
            aOutput += resultToCSV(obj, obj, ENC_UTF8, fileName);
          else if ((config.resultFormat == OPT_HRF) || (config.resultFormat == OPT_HRFV))   
            aOutput += resultToHRF(obj, obj, ENC_UTF8, fileName);
        }
      }
    };
    return(error);
  };

  try {
    aOutput = "";

    // error handling
    if (obj.error != "") { 
      error = obj.error + "'\n"; 
      return(error);
    }  

    if (aDirExtension == "")
      dirExtension = "*";
    else  
      dirExtension = aDirExtension;

    if (aRecursive) {
      for (const auto & file : std::filesystem::recursive_directory_iterator(path)) {
        matchFcn(file);
        if (error != "")
          return(error);
      }    
    } else {
      for (const auto & file : std::filesystem::directory_iterator(path)) {
        matchFcn(file);
        if (error != "")
          return(error);
      }  
    }
  } catch (const std::exception &aExc) {
    error = "error: cannot access directory '" + aPath + "' or empty" + "'\n"; 
    return(error);    
  }  
  
  return(error);
};


