  "maxFileSize": 1000,
  "patternNearest": 2,
  "patternBlock": 100,
  "positionType": 1,
  "logChannel": "default",
  "pdfReader": "pdftotext",
  "docxReader": "pandoc",
  "appPath": "..\\..\\..",
  "sentenceEnd": [ ".", "!", "?" ],
  "separators": [ " ", ".", "!", "?", ",", ";", ":", "/", "(", ")", "[", "]", "{", "}" ],
