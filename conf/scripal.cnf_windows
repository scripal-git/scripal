{
  "debugCompile": false,
  "debugRun": false,
  "showCode": false,
  "measureTime": false,
  "useEmpty": false,
  "translateDigits": false,
  "verboseResult": false,
  "decimalPoint": ".",
  "thousandsSep": ",",
